app ESTIMADOR-MIGRACIONES-FORMS-APEX (
    name: Estimador Migraciones Forms-APEX
    genAI {
        service: @claude-opus-5
    }
    logo {
        type: text
        text: Estimador Migraciones Forms-APEX
    }
    navigation {
        homeUrl: {
            page: 1
        }
        loginUrl: {
            page: LOGIN
        }
    }
    navigationMenu {
        listTemplate: @/side-navigation-menu
        templateOptions: [
            #DEFAULT#
            t-TreeNav--styleA
            js-navCollapsed--hidden
        ]
        list: @navigation-menu
    }
    navigationBar {
        list: @navigation-bar
        listTemplate: @/navigation-bar
        templateOptions: #DEFAULT#
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
        addBuiltWithApexToFooter: false
    }
    appFormatMasks {
        date: DS
        timestamp: DS
        timestampTimeZone: DS
    }
    authentication {
        scheme: @oracle-apex-accounts
    }
    sessionStateProtection {
        checksumSalt: A63D8CCC080AFB9B2F424C04B73790979D0CD5B0DDB1A04D62E91E586933932C
    }
    runtime {
        allowFeedback: true
    }

    errorHandling {
        errorHandlingFunctionName: ESTIMADOR.PKG_ERROR_HANDLER.handle_error
    }

    substitution APP_NAME (
        value {
            staticValue: Estimador Migraciones Forms-APEX
        }
    )

)

