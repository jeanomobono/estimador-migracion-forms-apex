                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column PESO_PORCENTAJE (
            type: numberField
            heading {
                heading: Peso (%)
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: PESO_PORCENTAJE
                dataType: number
            }
        )

        column RECURSOS_PARALELOS (
            type: numberField
            heading {
                heading: Recursos paralelos
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: RECURSOS_PARALELOS
                dataType: number
            }
        )

        column UPDATED_AT (
            type: textField
            heading {
                heading: Fecha
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: UPDATED_AT
                dataType: timestamp
                queryOnly: true
            }
        )

        column UPDATED_BY (
            type: textField
            heading {
                heading: Último cambio por
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: UPDATED_BY
                dataType: varchar2
                queryOnly: true
            }
        )

    )

