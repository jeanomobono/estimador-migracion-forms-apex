page 100 (
    name: Administración de Parámetros
    alias: ADMIN-PARAMETROS
    title: Parámetros del sistema
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb-admin-parametros (
        name: Parámetros
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region ig-complejidad (
        name: Horas por nivel de complejidad
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    parametro_complejidad_id,
                    tipo_elemento,
                    nivel_complejidad,
                    horas,
                    updated_by,
                    updated_at
                from parametros_complejidad
                order by tipo_elemento, horas
                ```
        }
        layout {
            sequence: 20
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: ig_complejidad
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        messages {
            whenNoDataFound: Sin datos
        }
        toolbar {
            controls: saveButton
        }
        advanced {
            savedReportMappingIdentifier: 3729484938984203
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
        )

        column HORAS (
            type: numberField
            heading {
                heading: Horas
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: HORAS
                dataType: number
            }
        )

        column NIVEL_COMPLEJIDAD (
            type: textField
            heading {
                heading: Nivel
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: NIVEL_COMPLEJIDAD
                dataType: varchar2
                queryOnly: true
            }
        )

        column PARAMETRO_COMPLEJIDAD_ID (
            type: hidden
            layout {
                sequence: 10
            }
            source {
                databaseColumn: PARAMETRO_COMPLEJIDAD_ID
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column TIPO_ELEMENTO (
            type: textField
            heading {
                heading: Tipo
            }
            layout {
                sequence: 20
            }
            source {
                databaseColumn: TIPO_ELEMENTO
                dataType: varchar2
                queryOnly: true
            }
        )

        column UPDATED_AT (
            type: textField
            heading {
                heading: Fecha
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: UPDATED_AT
                dataType: timestamp
                queryOnly: true
            }
        )

        column UPDATED_BY (
            type: textField
            heading {
                heading: Último cambio por
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: UPDATED_BY
                dataType: varchar2
                queryOnly: true
            }
        )

    )

    region ig-etapa-case (
        name: Distribución por etapa CASE
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    parametro_etapa_case_id,
                    etapa,
                    peso_porcentaje,
                    recursos_paralelos,
                    updated_by,
                    updated_at
                from parametros_etapa_case
                order by orden
                ```
        }
        layout {
            sequence: 40
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
